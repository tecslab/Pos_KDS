generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model ApplicationUser {
  id                 String               @id @db.Uuid
  displayName        String               @map("display_name")
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles              UserRoleAssignment[]
  auditEvents        AuditEvent[]
  assignedOrders     Order[]              @relation("AssignedWaiter")
  orderCancellations OrderCancellation[]
  recordedPayments   Payment[]            @relation("PaymentRecorder")
  authorizedOverages Payment[]            @relation("PaymentOverageAuthorizer")
  inventoryMovements InventoryMovement[]
  recipeVersions     RecipeVersion[]      @relation("RecipeVersionCreator")
  createdBatches     ProductionBatch[]    @relation("ProductionBatchCreator")
  completedBatches   ProductionBatch[]    @relation("ProductionBatchCompleter")
  operatingExpenses  OperatingExpense[]

  @@map("application_users")
}

model Role {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String               @unique
  name        String
  description String?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRoleAssignment {
  userId     String          @map("user_id") @db.Uuid
  roleId     String          @map("role_id") @db.Uuid
  assignedAt DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       ApplicationUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId        String          @map("actor_id") @db.Uuid
  occurredAt     DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  action         String
  entityType     String          @map("entity_type")
  entityId       String          @map("entity_id")
  previousValues Json?           @map("previous_values") @db.JsonB
  newValues      Json?           @map("new_values") @db.JsonB
  sourceIp       String?         @map("source_ip") @db.Inet
  actor          ApplicationUser @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}

model Restaurant {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  isActive          Boolean                  @map("is_active")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(6)
  configuration     RestaurantConfiguration?
  serviceLocations  ServiceLocation[]
  paymentMethods    PaymentMethod[]
  taxRates          RestaurantTaxRate[]
  productCatalog    ProductCatalog?
  productCategories ProductCategory[]
  products          Product[]
  orders            Order[]
  inventoryItems    InventoryItem[]
  recipes           Recipe[]
  expenseCategories ExpenseCategory[]

  @@map("restaurants")
}

model RestaurantConfiguration {
  restaurantId                        String     @id @map("restaurant_id") @db.Uuid
  address                             String?
  taxId                               String?    @map("tax_id")
  contactInformation                  Json?      @map("contact_information") @db.JsonB
  logoUrl                             String?    @map("logo_url")
  receiptHeader                       String?    @map("receipt_header")
  receiptFooter                       String?    @map("receipt_footer")
  thermalPrinterConfiguration         Json?      @map("thermal_printer_configuration") @db.JsonB
  serviceChargeRate                   Decimal    @map("service_charge_rate") @db.Decimal(7, 6)
  preparationWarningThresholdMinutes  Int        @map("preparation_warning_threshold_minutes")
  preparationCriticalThresholdMinutes Int        @map("preparation_critical_threshold_minutes")
  deliveryWarningThresholdMinutes     Int        @map("delivery_warning_threshold_minutes")
  deliveryCriticalThresholdMinutes    Int        @map("delivery_critical_threshold_minutes")
  inventoryPolicy                     Json       @map("inventory_policy") @db.JsonB
  printingBehavior                    Json       @map("printing_behavior") @db.JsonB
  businessHours                       Json       @map("business_hours") @db.JsonB
  createdAt                           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant                          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("restaurant_configurations")
}

model ServiceLocation {
  id                         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId               String     @map("restaurant_id") @db.Uuid
  name                       String
  type                       String
  displayOrder               Int        @map("display_order")
  isActive                   Boolean    @map("is_active")
  allowsMultipleActiveOrders Boolean    @map("allows_multiple_active_orders")
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                  DateTime?  @map("deleted_at") @db.Timestamptz(6)
  restaurant                 Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orders                     Order[]

  @@unique([restaurantId, name])
  @@unique([restaurantId, id])
  @@index([restaurantId, isActive, displayOrder])
  @@map("service_locations")
}

model PaymentMethod {
  id                       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId             String     @map("restaurant_id") @db.Uuid
  code                     String
  name                     String
  displayOrder             Int        @map("display_order")
  isActive                 Boolean    @map("is_active")
  bankAccountConfiguration Json?      @map("bank_account_configuration") @db.JsonB
  receiptConfiguration     Json?      @map("receipt_configuration") @db.JsonB
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?  @map("deleted_at") @db.Timestamptz(6)
  restaurant               Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payments                 Payment[]

  @@unique([restaurantId, code])
  @@unique([restaurantId, id])
  @@index([restaurantId, isActive, displayOrder])
  @@map("payment_methods")
}

model RestaurantTaxRate {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String           @map("restaurant_id") @db.Uuid
  code            String
  name            String
  rate            Decimal          @db.Decimal(7, 6)
  isActive        Boolean          @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productVersions ProductVersion[]

  @@unique([restaurantId, code])
  @@unique([restaurantId, id])
  @@index([restaurantId, isActive])
  @@map("restaurant_tax_rates")
}

model ProductCatalog {
  restaurantId String            @id @map("restaurant_id") @db.Uuid
  name         String
  isActive     Boolean           @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categories   ProductCategory[]

  @@index([restaurantId, isActive])
  @@map("product_catalogs")
}

model ProductCategory {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  name         String
  displayOrder Int            @map("display_order")
  isActive     Boolean        @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_categories_restaurant_fkey")
  catalog      ProductCatalog @relation(fields: [restaurantId], references: [restaurantId], onDelete: Restrict, onUpdate: Restrict, map: "product_categories_catalog_fkey")
  products     Product[]

  @@unique([restaurantId, name])
  @@unique([restaurantId, id])
  @@index([restaurantId, isActive, displayOrder])
  @@map("product_categories")
}

model Product {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String           @map("restaurant_id") @db.Uuid
  categoryId   String           @map("category_id") @db.Uuid
  displayOrder Int              @map("display_order")
  isActive     Boolean          @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category     ProductCategory  @relation(fields: [restaurantId, categoryId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)
  versions     ProductVersion[]
  recipes      Recipe[]

  @@unique([restaurantId, id])
  @@index([restaurantId, categoryId, isActive, displayOrder])
  @@map("products")
}

model ProductVersion {
  id                    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId          String                       @map("restaurant_id") @db.Uuid
  productId             String                       @map("product_id") @db.Uuid
  versionNumber         Int                          @map("version_number")
  name                  String
  unitPrice             Decimal                      @map("unit_price") @db.Decimal(12, 2)
  printerAlias          String                       @map("printer_alias")
  taxRateId             String                       @map("tax_rate_id") @db.Uuid
  taxCode               String                       @map("tax_code")
  taxName               String                       @map("tax_name")
  taxRate               Decimal                      @map("tax_rate") @db.Decimal(7, 6)
  priceIncludesTax      Boolean                      @map("price_includes_tax")
  recipeId              String?                      @map("recipe_id") @db.Uuid
  resaleInventoryItemId String?                      @map("resale_inventory_item_id") @db.Uuid
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  product               Product                      @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)
  tax                   RestaurantTaxRate            @relation(fields: [restaurantId, taxRateId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)
  recipe                Recipe?                      @relation("ProductVersionRecipe", fields: [restaurantId, recipeId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)
  resaleInventoryItem   InventoryItem?               @relation("ProductVersionResaleItem", fields: [restaurantId, resaleInventoryItemId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)
  options               ProductOption[]
  removableIngredients  ProductRemovableIngredient[]
  orderLineSnapshots    OrderLineSaleSnapshot[]

  @@unique([restaurantId, productId, versionNumber])
  @@unique([restaurantId, id])
  @@index([restaurantId, productId, versionNumber])
  @@index([restaurantId, taxRateId])
  @@index([restaurantId, recipeId])
  @@index([restaurantId, resaleInventoryItemId])
  @@map("product_versions")
}

model ProductOption {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String         @map("restaurant_id") @db.Uuid
  productVersionId String         @map("product_version_id") @db.Uuid
  name             String
  priceAdjustment  Decimal?       @map("price_adjustment") @db.Decimal(12, 2)
  displayOrder     Int            @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  productVersion   ProductVersion @relation(fields: [restaurantId, productVersionId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurantId, productVersionId, name])
  @@index([restaurantId, productVersionId, displayOrder], map: "product_options_version_display_order_idx")
  @@map("product_options")
}

model ProductRemovableIngredient {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String         @map("restaurant_id") @db.Uuid
  productVersionId String         @map("product_version_id") @db.Uuid
  name             String
  priceAdjustment  Decimal?       @map("price_adjustment") @db.Decimal(12, 2)
  displayOrder     Int            @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  productVersion   ProductVersion @relation(fields: [restaurantId, productVersionId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurantId, productVersionId, name], map: "product_removable_ingredients_version_name_key")
  @@index([restaurantId, productVersionId, displayOrder], map: "product_removable_ingredients_version_display_order_idx")
  @@map("product_removable_ingredients")
}

enum OrderStatus {
  PENDING
  READY
  ON_THE_WAY
  DELIVERED
  PAID
  CANCELLED

  @@map("order_status")
}

enum CustomerBasketStatus {
  PENDING
  PAID

  @@map("customer_basket_status")
}

model Order {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId      String             @map("restaurant_id") @db.Uuid
  serviceLocationId String             @map("service_location_id") @db.Uuid
  assignedWaiterId  String             @map("assigned_waiter_id") @db.Uuid
  orderNumber       String             @unique @map("order_number")
  status            OrderStatus
  notes             String?
  totalAmount       Decimal            @map("total_amount") @db.Decimal(12, 2)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt           DateTime?          @map("ready_at") @db.Timestamptz(6)
  onTheWayAt        DateTime?          @map("on_the_way_at") @db.Timestamptz(6)
  deliveredAt       DateTime?          @map("delivered_at") @db.Timestamptz(6)
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serviceLocation   ServiceLocation    @relation(fields: [restaurantId, serviceLocationId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "orders_service_location_fkey")
  assignedWaiter    ApplicationUser    @relation("AssignedWaiter", fields: [assignedWaiterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  baskets           CustomerBasket[]
  cancellation      OrderCancellation?

  @@unique([restaurantId, id])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, serviceLocationId, status])
  @@index([assignedWaiterId, status])
  @@map("orders")
}

model CustomerBasket {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String               @map("restaurant_id") @db.Uuid
  orderId      String               @map("order_id") @db.Uuid
  status       CustomerBasketStatus
  totalAmount  Decimal              @map("total_amount") @db.Decimal(12, 2)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt       DateTime?            @map("paid_at") @db.Timestamptz(6)
  order        Order                @relation(fields: [restaurantId, orderId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "customer_baskets_order_fkey")
  lines        OrderLine[]
  payments     Payment[]

  @@unique([restaurantId, id])
  @@index([restaurantId, orderId, status])
  @@map("customer_baskets")
}

model OrderLine {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId      String                  @map("restaurant_id") @db.Uuid
  basketId          String                  @map("basket_id") @db.Uuid
  currentSnapshotId String                  @unique @map("current_snapshot_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  basket            CustomerBasket          @relation(fields: [restaurantId, basketId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "order_lines_basket_fkey")
  snapshots         OrderLineSaleSnapshot[] @relation("LineSnapshots")
  currentSnapshot   OrderLineSaleSnapshot   @relation("CurrentLineSnapshot", fields: [restaurantId, id, currentSnapshotId], references: [restaurantId, orderLineId, id], onDelete: Restrict, onUpdate: Restrict, map: "order_lines_current_snapshot_fkey")

  @@unique([restaurantId, id])
  @@unique([restaurantId, id, currentSnapshotId], map: "order_lines_current_snapshot_owner_key")
  @@index([restaurantId, basketId])
  @@map("order_lines")
}

model OrderLineSaleSnapshot {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId       String         @map("restaurant_id") @db.Uuid
  orderLineId        String         @map("order_line_id") @db.Uuid
  revisionNumber     Int            @map("revision_number")
  productVersionId   String         @map("product_version_id") @db.Uuid
  productName        String         @map("product_name")
  quantity           Int
  baseUnitPrice      Decimal        @map("base_unit_price") @db.Decimal(12, 2)
  finalUnitPrice     Decimal        @map("final_unit_price") @db.Decimal(12, 2)
  lineTotal          Decimal        @map("line_total") @db.Decimal(12, 2)
  taxCode            String         @map("tax_code")
  taxName            String         @map("tax_name")
  taxRate            Decimal        @map("tax_rate") @db.Decimal(7, 6)
  priceIncludesTax   Boolean        @map("price_includes_tax")
  selectedOptions    Json           @map("selected_options") @db.JsonB
  removedIngredients Json           @map("removed_ingredients") @db.JsonB
  observations       String?
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  orderLine          OrderLine      @relation("LineSnapshots", fields: [restaurantId, orderLineId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "order_line_snapshots_line_fkey")
  currentForLine     OrderLine?     @relation("CurrentLineSnapshot")
  productVersion     ProductVersion @relation(fields: [restaurantId, productVersionId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "order_line_snapshots_product_version_fkey")

  @@unique([restaurantId, orderLineId, revisionNumber], map: "order_line_snapshots_line_revision_key")
  @@unique([restaurantId, orderLineId, id], map: "order_line_snapshots_current_key")
  @@index([restaurantId, productVersionId], map: "order_line_snapshots_product_version_idx")
  @@map("order_line_sale_snapshots")
}

model OrderCancellation {
  orderId        String          @id @map("order_id") @db.Uuid
  restaurantId   String          @map("restaurant_id") @db.Uuid
  cancelledById  String          @map("cancelled_by_id") @db.Uuid
  previousStatus OrderStatus     @map("previous_status")
  reason         String
  cancelledAt    DateTime        @default(now()) @map("cancelled_at") @db.Timestamptz(6)
  order          Order           @relation(fields: [restaurantId, orderId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "order_cancellations_order_fkey")
  cancelledBy    ApplicationUser @relation(fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurantId, orderId])
  @@index([cancelledById, cancelledAt])
  @@map("order_cancellations")
}

model Payment {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId          String           @map("restaurant_id") @db.Uuid
  basketId              String           @map("basket_id") @db.Uuid
  paymentMethodId       String           @map("payment_method_id") @db.Uuid
  recordedById          String           @map("recorded_by_id") @db.Uuid
  amount                Decimal          @db.Decimal(12, 2)
  paymentMethodCode     String           @map("payment_method_code")
  paymentMethodName     String           @map("payment_method_name")
  referenceNumber       String?          @map("reference_number")
  comments              String?
  recordedAt            DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  overageAuthorizedById String?          @map("overage_authorized_by_id") @db.Uuid
  overageAuthorizedAt   DateTime?        @map("overage_authorized_at") @db.Timestamptz(6)
  overageReason         String?          @map("overage_reason")
  basket                CustomerBasket   @relation(fields: [restaurantId, basketId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "payments_basket_fkey")
  paymentMethod         PaymentMethod    @relation(fields: [restaurantId, paymentMethodId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "payments_method_fkey")
  recordedBy            ApplicationUser  @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  overageAuthorizedBy   ApplicationUser? @relation("PaymentOverageAuthorizer", fields: [overageAuthorizedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payments_overage_authorizer_fkey")

  @@unique([restaurantId, id])
  @@index([restaurantId, basketId, recordedAt])
  @@index([restaurantId, paymentMethodId])
  @@index([recordedById, recordedAt])
  @@index([overageAuthorizedById])
  @@map("payments")
}

enum InventoryItemType {
  RAW_INGREDIENT
  PRODUCED_ITEM
  RESALE_ITEM

  @@map("inventory_item_type")
}

enum InventoryMovementType {
  PURCHASE
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  SALE
  ADJUSTMENT
  WASTE
  ROLLBACK

  @@map("inventory_movement_type")
}

enum InventoryBusinessOriginType {
  PURCHASE
  PRODUCTION
  SALE
  ADJUSTMENT
  WASTE
  ROLLBACK

  @@map("inventory_business_origin_type")
}

enum InventoryAlertStatus {
  ACTIVE
  RESOLVED

  @@map("inventory_alert_status")
}

model InventoryItem {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId          String              @map("restaurant_id") @db.Uuid
  name                  String
  type                  InventoryItemType
  unitOfMeasure         String              @map("unit_of_measure")
  minimumStockLevel     Decimal             @map("minimum_stock_level") @db.Decimal(14, 3)
  isActive              Boolean             @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?           @map("deleted_at") @db.Timestamptz(6)
  restaurant            Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements             InventoryMovement[]
  alerts                InventoryAlert[]
  outputRecipes         Recipe[]            @relation("RecipeOutputItem")
  recipeIngredients     RecipeIngredient[]  @relation("RecipeIngredientItem")
  resaleProductVersions ProductVersion[]    @relation("ProductVersionResaleItem")

  @@unique([restaurantId, name])
  @@unique([restaurantId, id])
  @@index([restaurantId, type, isActive])
  @@map("inventory_items")
}

model InventoryMovement {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId       String                      @map("restaurant_id") @db.Uuid
  inventoryItemId    String                      @map("inventory_item_id") @db.Uuid
  type               InventoryMovementType
  quantityDelta      Decimal                     @map("quantity_delta") @db.Decimal(14, 3)
  unitOfMeasure      String                      @map("unit_of_measure")
  recordedById       String                      @map("recorded_by_id") @db.Uuid
  recordedAt         DateTime                    @default(now()) @map("recorded_at") @db.Timestamptz(6)
  businessOriginType InventoryBusinessOriginType @map("business_origin_type")
  businessOriginId   String                      @map("business_origin_id") @db.Uuid
  comments           String?
  reversedMovementId String?                     @map("reversed_movement_id") @db.Uuid
  inventoryItem      InventoryItem               @relation(fields: [restaurantId, inventoryItemId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "inventory_movements_item_fkey")
  recordedBy         ApplicationUser             @relation(fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversedMovement   InventoryMovement?          @relation("InventoryMovementReversal", fields: [restaurantId, inventoryItemId, reversedMovementId], references: [restaurantId, inventoryItemId, id], onDelete: Restrict, onUpdate: Restrict, map: "inventory_movements_reversed_fkey")
  reversalMovements  InventoryMovement[]         @relation("InventoryMovementReversal")

  @@unique([restaurantId, inventoryItemId, id], map: "inventory_movements_item_id_key")
  @@index([restaurantId, inventoryItemId, recordedAt])
  @@index([restaurantId, businessOriginType, businessOriginId], map: "inventory_movements_origin_idx")
  @@index([recordedById, recordedAt])
  @@index([reversedMovementId])
  @@map("inventory_movements")
}

model InventoryAlert {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String               @map("restaurant_id") @db.Uuid
  inventoryItemId String               @map("inventory_item_id") @db.Uuid
  status          InventoryAlertStatus
  threshold       Decimal              @db.Decimal(14, 3)
  observedBalance Decimal              @map("observed_balance") @db.Decimal(14, 3)
  openedAt        DateTime             @default(now()) @map("opened_at") @db.Timestamptz(6)
  resolvedAt      DateTime?            @map("resolved_at") @db.Timestamptz(6)
  inventoryItem   InventoryItem        @relation(fields: [restaurantId, inventoryItemId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "inventory_alerts_item_fkey")

  @@unique([restaurantId, id])
  @@index([restaurantId, inventoryItemId, status, openedAt])
  @@map("inventory_alerts")
}

view InventoryBalance {
  restaurantId    String  @map("restaurant_id") @db.Uuid
  inventoryItemId String  @map("inventory_item_id") @db.Uuid
  unitOfMeasure   String  @map("unit_of_measure")
  currentBalance  Decimal @map("current_balance") @db.Decimal(14, 3)

  @@unique([restaurantId, inventoryItemId])
  @@map("inventory_balances")
}

enum ProductionBatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED

  @@map("production_batch_status")
}

enum ExpenseOriginType {
  MANUAL
  PURCHASE

  @@map("expense_origin_type")
}

model Recipe {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId          String           @map("restaurant_id") @db.Uuid
  productId             String           @map("product_id") @db.Uuid
  outputInventoryItemId String           @map("output_inventory_item_id") @db.Uuid
  name                  String
  isActive              Boolean          @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?        @map("deleted_at") @db.Timestamptz(6)
  restaurant            Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product               Product          @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "recipes_product_fkey")
  outputInventoryItem   InventoryItem    @relation("RecipeOutputItem", fields: [restaurantId, outputInventoryItemId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "recipes_output_item_fkey")
  versions              RecipeVersion[]
  productVersions       ProductVersion[] @relation("ProductVersionRecipe")

  @@unique([restaurantId, name])
  @@unique([restaurantId, id])
  @@index([restaurantId, productId, isActive])
  @@index([restaurantId, outputInventoryItemId])
  @@map("recipes")
}

model RecipeVersion {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId      String             @map("restaurant_id") @db.Uuid
  recipeId          String             @map("recipe_id") @db.Uuid
  versionNumber     Int                @map("version_number")
  producedQuantity  Decimal            @map("produced_quantity") @db.Decimal(14, 3)
  producedUnit      String             @map("produced_unit")
  createdById       String             @map("created_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  recipe            Recipe             @relation(fields: [restaurantId, recipeId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "recipe_versions_recipe_fkey")
  createdBy         ApplicationUser    @relation("RecipeVersionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredients       RecipeIngredient[]
  productionBatches ProductionBatch[]

  @@unique([restaurantId, recipeId, versionNumber], map: "recipe_versions_recipe_number_key")
  @@unique([restaurantId, id])
  @@index([createdById, createdAt])
  @@map("recipe_versions")
}

model RecipeIngredient {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String        @map("restaurant_id") @db.Uuid
  recipeVersionId  String        @map("recipe_version_id") @db.Uuid
  inventoryItemId  String        @map("inventory_item_id") @db.Uuid
  requiredQuantity Decimal       @map("required_quantity") @db.Decimal(14, 3)
  unitOfMeasure    String        @map("unit_of_measure")
  recipeVersion    RecipeVersion @relation(fields: [restaurantId, recipeVersionId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "recipe_ingredients_version_fkey")
  inventoryItem    InventoryItem @relation("RecipeIngredientItem", fields: [restaurantId, inventoryItemId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "recipe_ingredients_item_fkey")

  @@unique([restaurantId, recipeVersionId, inventoryItemId], map: "recipe_ingredients_version_item_key")
  @@index([restaurantId, inventoryItemId])
  @@map("recipe_ingredients")
}

model ProductionBatch {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String                @map("restaurant_id") @db.Uuid
  recipeVersionId  String                @map("recipe_version_id") @db.Uuid
  status           ProductionBatchStatus
  plannedQuantity  Decimal               @map("planned_quantity") @db.Decimal(14, 3)
  producedQuantity Decimal?              @map("produced_quantity") @db.Decimal(14, 3)
  unitOfMeasure    String                @map("unit_of_measure")
  createdById      String                @map("created_by_id") @db.Uuid
  completedById    String?               @map("completed_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt        DateTime?             @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(6)
  notes            String?
  recipeVersion    RecipeVersion         @relation(fields: [restaurantId, recipeVersionId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "production_batches_recipe_version_fkey")
  createdBy        ApplicationUser       @relation("ProductionBatchCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  completedBy      ApplicationUser?      @relation("ProductionBatchCompleter", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurantId, id])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, recipeVersionId, createdAt], map: "production_batches_recipe_created_idx")
  @@index([createdById, createdAt])
  @@index([completedById, completedAt])
  @@map("production_batches")
}

model ExpenseCategory {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String             @map("restaurant_id") @db.Uuid
  code         String
  name         String
  isActive     Boolean            @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  expenses     OperatingExpense[]

  @@unique([restaurantId, code])
  @@unique([restaurantId, id])
  @@index([restaurantId, isActive, name])
  @@map("expense_categories")
}

model OperatingExpense {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String            @map("restaurant_id") @db.Uuid
  expenseCategoryId   String            @map("expense_category_id") @db.Uuid
  amount              Decimal           @db.Decimal(12, 2)
  description         String
  incurredAt          DateTime          @map("incurred_at") @db.Timestamptz(6)
  recordedAt          DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedById        String            @map("recorded_by_id") @db.Uuid
  referenceNumber     String?           @map("reference_number")
  comments            String?
  expenseCategoryCode String            @map("expense_category_code")
  expenseCategoryName String            @map("expense_category_name")
  originType          ExpenseOriginType @map("origin_type")
  originId            String?           @map("origin_id") @db.Uuid
  expenseCategory     ExpenseCategory   @relation(fields: [restaurantId, expenseCategoryId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict, map: "operating_expenses_category_fkey")
  recordedBy          ApplicationUser   @relation(fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurantId, id])
  @@index([restaurantId, expenseCategoryId, incurredAt], map: "operating_expenses_category_incurred_idx")
  @@index([restaurantId, originType, originId])
  @@index([recordedById, recordedAt])
  @@map("operating_expenses")
}
