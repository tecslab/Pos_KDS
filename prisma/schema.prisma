generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ApplicationUser {
  id          String               @id @db.Uuid
  displayName String               @map("display_name")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       UserRoleAssignment[]
  auditEvents AuditEvent[]

  @@map("application_users")
}

model Role {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String               @unique
  name        String
  description String?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRoleAssignment {
  userId     String          @map("user_id") @db.Uuid
  roleId     String          @map("role_id") @db.Uuid
  assignedAt DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       ApplicationUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId        String          @map("actor_id") @db.Uuid
  occurredAt     DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  action         String
  entityType     String          @map("entity_type")
  entityId       String          @map("entity_id")
  previousValues Json?           @map("previous_values") @db.JsonB
  newValues      Json?           @map("new_values") @db.JsonB
  sourceIp       String?         @map("source_ip") @db.Inet
  actor          ApplicationUser @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}
