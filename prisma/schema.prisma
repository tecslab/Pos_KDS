generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ApplicationUser {
  id          String               @id @db.Uuid
  displayName String               @map("display_name")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       UserRoleAssignment[]
  auditEvents AuditEvent[]

  @@map("application_users")
}

model Role {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String               @unique
  name        String
  description String?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRoleAssignment {
  userId     String          @map("user_id") @db.Uuid
  roleId     String          @map("role_id") @db.Uuid
  assignedAt DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       ApplicationUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId        String          @map("actor_id") @db.Uuid
  occurredAt     DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  action         String
  entityType     String          @map("entity_type")
  entityId       String          @map("entity_id")
  previousValues Json?           @map("previous_values") @db.JsonB
  newValues      Json?           @map("new_values") @db.JsonB
  sourceIp       String?         @map("source_ip") @db.Inet
  actor          ApplicationUser @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}

model Restaurant {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  isActive          Boolean                  @map("is_active")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(6)
  configuration     RestaurantConfiguration?
  serviceLocations  ServiceLocation[]
  paymentMethods    PaymentMethod[]
  taxRates          RestaurantTaxRate[]
  productCatalog    ProductCatalog?
  productCategories ProductCategory[]
  products          Product[]

  @@map("restaurants")
}

model RestaurantConfiguration {
  restaurantId                        String     @id @map("restaurant_id") @db.Uuid
  address                             String?
  taxId                               String?    @map("tax_id")
  contactInformation                  Json?      @map("contact_information") @db.JsonB
  logoUrl                             String?    @map("logo_url")
  receiptHeader                       String?    @map("receipt_header")
  receiptFooter                       String?    @map("receipt_footer")
  thermalPrinterConfiguration         Json?      @map("thermal_printer_configuration") @db.JsonB
  serviceChargeRate                   Decimal    @map("service_charge_rate") @db.Decimal(7, 6)
  preparationWarningThresholdMinutes  Int        @map("preparation_warning_threshold_minutes")
  preparationCriticalThresholdMinutes Int        @map("preparation_critical_threshold_minutes")
  deliveryWarningThresholdMinutes     Int        @map("delivery_warning_threshold_minutes")
  deliveryCriticalThresholdMinutes    Int        @map("delivery_critical_threshold_minutes")
  inventoryPolicy                     Json       @map("inventory_policy") @db.JsonB
  printingBehavior                    Json       @map("printing_behavior") @db.JsonB
  businessHours                       Json       @map("business_hours") @db.JsonB
  createdAt                           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant                          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("restaurant_configurations")
}

model ServiceLocation {
  id                         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId               String     @map("restaurant_id") @db.Uuid
  name                       String
  type                       String
  displayOrder               Int        @map("display_order")
  isActive                   Boolean    @map("is_active")
  allowsMultipleActiveOrders Boolean    @map("allows_multiple_active_orders")
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                  DateTime?  @map("deleted_at") @db.Timestamptz(6)
  restaurant                 Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive, displayOrder])
  @@map("service_locations")
}

model PaymentMethod {
  id                       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId             String     @map("restaurant_id") @db.Uuid
  code                     String
  name                     String
  displayOrder             Int        @map("display_order")
  isActive                 Boolean    @map("is_active")
  bankAccountConfiguration Json?      @map("bank_account_configuration") @db.JsonB
  receiptConfiguration     Json?      @map("receipt_configuration") @db.JsonB
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?  @map("deleted_at") @db.Timestamptz(6)
  restaurant               Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive, displayOrder])
  @@map("payment_methods")
}

model RestaurantTaxRate {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String           @map("restaurant_id") @db.Uuid
  code            String
  name            String
  rate            Decimal          @db.Decimal(7, 6)
  isActive        Boolean          @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productVersions ProductVersion[]

  @@unique([restaurantId, code])
  @@unique([restaurantId, id])
  @@index([restaurantId, isActive])
  @@map("restaurant_tax_rates")
}

model ProductCatalog {
  restaurantId String            @id @map("restaurant_id") @db.Uuid
  name         String
  isActive     Boolean           @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categories   ProductCategory[]

  @@index([restaurantId, isActive])
  @@map("product_catalogs")
}

model ProductCategory {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  name         String
  displayOrder Int            @map("display_order")
  isActive     Boolean        @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_categories_restaurant_fkey")
  catalog      ProductCatalog @relation(fields: [restaurantId], references: [restaurantId], onDelete: Restrict, onUpdate: Restrict, map: "product_categories_catalog_fkey")
  products     Product[]

  @@unique([restaurantId, name])
  @@unique([restaurantId, id])
  @@index([restaurantId, isActive, displayOrder])
  @@map("product_categories")
}

model Product {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String           @map("restaurant_id") @db.Uuid
  categoryId   String           @map("category_id") @db.Uuid
  displayOrder Int              @map("display_order")
  isActive     Boolean          @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category     ProductCategory  @relation(fields: [restaurantId, categoryId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)
  versions     ProductVersion[]

  @@unique([restaurantId, id])
  @@index([restaurantId, categoryId, isActive, displayOrder])
  @@map("products")
}

model ProductVersion {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId         String                       @map("restaurant_id") @db.Uuid
  productId            String                       @map("product_id") @db.Uuid
  versionNumber        Int                          @map("version_number")
  name                 String
  unitPrice            Decimal                      @map("unit_price") @db.Decimal(12, 2)
  printerAlias         String                       @map("printer_alias")
  taxRateId            String                       @map("tax_rate_id") @db.Uuid
  taxCode              String                       @map("tax_code")
  taxName              String                       @map("tax_name")
  taxRate              Decimal                      @map("tax_rate") @db.Decimal(7, 6)
  priceIncludesTax     Boolean                      @map("price_includes_tax")
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  product              Product                      @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)
  tax                  RestaurantTaxRate            @relation(fields: [restaurantId, taxRateId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)
  options              ProductOption[]
  removableIngredients ProductRemovableIngredient[]

  @@unique([restaurantId, productId, versionNumber])
  @@unique([restaurantId, id])
  @@index([restaurantId, productId, versionNumber])
  @@index([restaurantId, taxRateId])
  @@map("product_versions")
}

model ProductOption {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String         @map("restaurant_id") @db.Uuid
  productVersionId String         @map("product_version_id") @db.Uuid
  name             String
  priceAdjustment  Decimal?       @map("price_adjustment") @db.Decimal(12, 2)
  displayOrder     Int            @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  productVersion   ProductVersion @relation(fields: [restaurantId, productVersionId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurantId, productVersionId, name])
  @@index([restaurantId, productVersionId, displayOrder], map: "product_options_version_display_order_idx")
  @@map("product_options")
}

model ProductRemovableIngredient {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String         @map("restaurant_id") @db.Uuid
  productVersionId String         @map("product_version_id") @db.Uuid
  name             String
  priceAdjustment  Decimal?       @map("price_adjustment") @db.Decimal(12, 2)
  displayOrder     Int            @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  productVersion   ProductVersion @relation(fields: [restaurantId, productVersionId], references: [restaurantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([restaurantId, productVersionId, name], map: "product_removable_ingredients_version_name_key")
  @@index([restaurantId, productVersionId, displayOrder], map: "product_removable_ingredients_version_display_order_idx")
  @@map("product_removable_ingredients")
}
